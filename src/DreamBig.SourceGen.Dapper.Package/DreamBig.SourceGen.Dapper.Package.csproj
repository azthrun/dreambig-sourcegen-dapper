<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net5.0;net6.0;net7.0;net8.0;net10.0</TargetFrameworks>
    <AssemblyName>DreamBig.SourceGen.Dapper.Package</AssemblyName>
    <NoWarn>$(NoWarn);CS1591;NU5128</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <PackageId>DreamBig.SourceGen.Dapper</PackageId>
    <Title>DreamBig.SourceGen.Dapper</Title>
    <Description>Attribute-driven source-generated Dapper repository implementation with SQL Server-first support for CRUD, joins, and stored procedures.</Description>
    <Authors>DreamBig</Authors>
    <PackageTags>dapper;source-generator;orm;sql-server</PackageTags>
    <PackageProjectUrl>https://github.com/yunqichen/dreambig-sourcegen-dapper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yunqichen/dreambig-sourcegen-dapper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\nuget</PackageOutputPath>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>false</DevelopmentDependency>
    <NoPackageAnalysis>false</NoPackageAnalysis>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DreamBig.SourceGen.Dapper.Abstractions\DreamBig.SourceGen.Dapper.Abstractions.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\DreamBig.SourceGen.Dapper.Generator\DreamBig.SourceGen.Dapper.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="..\DreamBig.SourceGen.Dapper.Abstractions\bin\$(Configuration)\net5.0\DreamBig.SourceGen.Dapper.Abstractions.dll" Pack="true" PackagePath="lib/net5.0/" Visible="false" />
    <None Include="..\DreamBig.SourceGen.Dapper.Abstractions\bin\$(Configuration)\net5.0\DreamBig.SourceGen.Dapper.Abstractions.xml" Pack="true" PackagePath="lib/net5.0/" Visible="false" />
    <None Include="..\DreamBig.SourceGen.Dapper.Abstractions\bin\$(Configuration)\net6.0\DreamBig.SourceGen.Dapper.Abstractions.dll" Pack="true" PackagePath="lib/net6.0/" Visible="false" />
    <None Include="..\DreamBig.SourceGen.Dapper.Abstractions\bin\$(Configuration)\net6.0\DreamBig.SourceGen.Dapper.Abstractions.xml" Pack="true" PackagePath="lib/net6.0/" Visible="false" />
    <None Include="..\DreamBig.SourceGen.Dapper.Abstractions\bin\$(Configuration)\net7.0\DreamBig.SourceGen.Dapper.Abstractions.dll" Pack="true" PackagePath="lib/net7.0/" Visible="false" />
    <None Include="..\DreamBig.SourceGen.Dapper.Abstractions\bin\$(Configuration)\net7.0\DreamBig.SourceGen.Dapper.Abstractions.xml" Pack="true" PackagePath="lib/net7.0/" Visible="false" />
    <None Include="..\DreamBig.SourceGen.Dapper.Abstractions\bin\$(Configuration)\net8.0\DreamBig.SourceGen.Dapper.Abstractions.dll" Pack="true" PackagePath="lib/net8.0/" Visible="false" />
    <None Include="..\DreamBig.SourceGen.Dapper.Abstractions\bin\$(Configuration)\net8.0\DreamBig.SourceGen.Dapper.Abstractions.xml" Pack="true" PackagePath="lib/net8.0/" Visible="false" />
    <None Include="..\DreamBig.SourceGen.Dapper.Abstractions\bin\$(Configuration)\net10.0\DreamBig.SourceGen.Dapper.Abstractions.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
    <None Include="..\DreamBig.SourceGen.Dapper.Abstractions\bin\$(Configuration)\net10.0\DreamBig.SourceGen.Dapper.Abstractions.xml" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
    <None Include="..\DreamBig.SourceGen.Dapper.Generator\bin\$(Configuration)\netstandard2.0\DreamBig.SourceGen.Dapper.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
  </ItemGroup>

  <Target Name="BuildPackageDependencies" BeforeTargets="Pack" Condition="'$(NoBuild)' != 'true'">
    <MSBuild
      Projects="..\DreamBig.SourceGen.Dapper.Abstractions\DreamBig.SourceGen.Dapper.Abstractions.csproj;..\DreamBig.SourceGen.Dapper.Generator\DreamBig.SourceGen.Dapper.Generator.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);UseSharedCompilation=false" />
  </Target>
</Project>
